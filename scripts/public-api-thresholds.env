# Public API gate thresholds (profile aware)
# Default profile is `standard`.

# standard (release-blocking default)
PUBLIC_API_STANDARD_SLO_AVAILABILITY=99.9
PUBLIC_API_STANDARD_GATEWAY_5XX_RATIO_MAX=0.1
PUBLIC_API_STANDARD_P95_MS=80
PUBLIC_API_STANDARD_P99_MS=200

# strict (future hardening profile)
PUBLIC_API_STRICT_SLO_AVAILABILITY=99.95
PUBLIC_API_STRICT_GATEWAY_5XX_RATIO_MAX=0.05
PUBLIC_API_STRICT_P95_MS=60
PUBLIC_API_STRICT_P99_MS=150

# observe (report-first profile, does not block gate)
PUBLIC_API_OBSERVE_SLO_AVAILABILITY=99.0
PUBLIC_API_OBSERVE_GATEWAY_5XX_RATIO_MAX=1.0
PUBLIC_API_OBSERVE_P95_MS=150
PUBLIC_API_OBSERVE_P99_MS=300

# Legacy compatibility keys for old scripts (mapped to standard profile)
PUBLIC_API_SLO_AVAILABILITY=99.9
PUBLIC_API_GATEWAY_5XX_RATIO_MAX=0.1
PUBLIC_API_P95_MS=80
PUBLIC_API_P99_MS=200
